    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.10.7",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "webextension-polyfill": "^0.12.0"
  }
}
